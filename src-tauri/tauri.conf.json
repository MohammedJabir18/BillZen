{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BillZen",
  "version": "0.1.6",
  "identifier": "com.billzen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BillZen \u2014 Offline Billing",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 360,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost tauri:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1011
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MzczRDlDMEM0NTY5RjQKUldUMGFVVU1uRDAzNmI0dk1lS25UZERmbnl0ZjFjc3R6bnY2dTkzWjBja0M2Zys4Z2hLYmFpbFAK",
      "endpoints": [
        "https://github.com/MohammedJabir18/BillZen/releases/latest/download/desktop-update.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
