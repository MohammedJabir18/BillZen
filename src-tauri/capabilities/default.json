{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window of BillZen",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-business-settings",
    "allow-update-business-settings",
    "allow-update-business-profile",
    "allow-complete-business-setup",
    "allow-update-appearance-preference",


    "allow-update-guide-status",
    "allow-check-print-support",
    "allow-ping",
    "allow-get-products",
    "allow-create-product",
    "allow-update-product",
    "allow-archive-product",
    "allow-restore-product",
    "allow-get-customers",
    "allow-create-customer",
    "allow-update-customer",
    "allow-archive-customer",
    "allow-restore-customer",
    "allow-get-categories",
    "allow-create-category",
    "allow-get-money-accounts",
    "allow-create-money-account",
    "allow-update-money-account",
    "allow-get-cashbook-categories",
    "allow-create-cashbook-category",
    "allow-get-cashbook-parties",
    "allow-create-cashbook-party",
    "allow-post-cashbook-voucher",
    "allow-reverse-cashbook-voucher",
    "allow-get-cashbook-ledger",
    "allow-export-workspace-backup",
    "allow-restore-workspace-backup"
  ]
}
